rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthed() && getRole() == role;
    }

    function inRoles(roles) {
      return isAuthed() && getRole() in roles;
    }

    function isStaff() {
      return inRoles(['admin', 'property_owner', 'property_manager']);
    }

    function isOwnerOrAdmin() {
      return inRoles(['admin', 'property_owner']);
    }

    // ---------- PROFILES ----------
    match /profiles/{userId} {
      allow read: if isAuthed();

      // First sign-in self-creation. role MUST start as one of the
      // self-registerable roles (or absent).
      allow create: if isAuthed()
        && isSelf(userId)
        && (
          !('role' in request.resource.data)
          || request.resource.data.role in ['resident', 'tenant', 'contractor', 'property_manager']
        );

      // Self updates: cannot escalate role / approval / active flags.
      allow update: if isAuthed() && isSelf(userId)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('is_active' in request.resource.data.diff(resource.data).affectedKeys())
        && !('approval_status' in request.resource.data.diff(resource.data).affectedKeys());

      // Staff can promote / deactivate / set approval status.
      allow update: if isStaff();

      allow delete: if hasRole('admin');

      // Subcollection: contractor references — readable by staff, writable by owner.
      match /references/{refId} {
        allow read: if isStaff() || isSelf(userId);
        allow write: if isSelf(userId) || isStaff();
      }
    }

    // ---------- BANKING DETAILS ----------
    // Stored separately so they can be locked down independently of profile.
    // Only the user themselves and owner/admin can read.
    match /banking_details/{userId} {
      allow read: if isAuthed() && (isSelf(userId) || isOwnerOrAdmin());
      allow create, update: if isAuthed() && isSelf(userId);
      allow delete: if isOwnerOrAdmin();
    }

    // ---------- ROOMS ----------
    match /rooms/{roomId} {
      allow read: if isAuthed();
      allow write: if isStaff();
    }

    // ---------- TICKETS ----------
    match /tickets/{ticketId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.created_by == request.auth.uid;

      allow update: if isStaff()
        || (hasRole('contractor') && resource.data.assigned_contractor == request.auth.uid);

      allow delete: if hasRole('admin');

      match /comments/{commentId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.author_id == request.auth.uid;
        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.uploaded_by == request.auth.uid;
        allow update: if false;
        allow delete: if isStaff()
          || (isAuthed() && resource.data.uploaded_by == request.auth.uid);
      }

      match /approvals/{approvalId} {
        allow read: if isAuthed();
        allow create: if isStaff()
          && request.resource.data.approver_id == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- QUOTATIONS ----------
    match /quotations/{quoteId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );

      allow create: if hasRole('contractor')
        && request.resource.data.contractor_id == request.auth.uid;

      allow update: if isStaff();
      allow delete: if hasRole('admin');

      match /items/{itemId} {
        allow read: if isAuthed();
        allow create: if hasRole('contractor');
        allow update, delete: if isStaff();
      }
    }

    // ---------- PAYMENTS ----------
    match /payments/{paymentId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if hasRole('admin');
    }

    // ---------- CONTRACTOR RATINGS ----------
    match /contractor_ratings/{ratingId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );
      allow create, update: if isStaff()
        && request.resource.data.rated_by == request.auth.uid;
      allow delete: if hasRole('admin');
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notifId} {
      allow read: if isAuthed() && resource.data.user_id == request.auth.uid;

      allow create: if isAuthed()
        && request.resource.data.read == false
        && 'user_id' in request.resource.data;

      allow update: if isAuthed() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);

      allow delete: if false;
    }

    // ---------- AUDIT LOGS ----------
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthed()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- DOCUMENTS (signed acknowledgements: house rules, lease, etc) ----------
    // Each user signs their own ack — id pattern is `{user_id}_{doc_id}`.
    // - User can read/write their own ack record.
    // - Staff can read everyone's acks (for compliance + audit).
    // - Nobody can delete a signed ack (the signature is the audit trail).
    match /documents/{docId} {
      allow read: if isAuthed() && (
        isStaff()
        || resource.data.user_id == request.auth.uid
      );
      allow create: if isAuthed()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthed()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // ---------- VERIFICATIONS (VerifyNow results, written by Cloud Function) ----------
    // Only staff can read; client-side writes blocked (functions use Admin SDK).
    match /verifications/{userId} {
      allow read: if isStaff() || isSelf(userId);
      allow write: if false;
    }

    // ---------- MAIL OUTBOX (Trigger Email Extension) ----------
    // Cloud Function writes outgoing emails here; the firestore-send-email
    // extension picks them up. Nothing on the client should read these.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
