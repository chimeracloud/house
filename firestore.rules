rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthed() && getRole() == role;
    }

    function inRoles(roles) {
      return isAuthed() && getRole() in roles;
    }

    function isStaff() {
      return inRoles(['admin', 'property_owner', 'property_manager']);
    }

    // ---------- PROFILES ----------
    // - Any authenticated user can READ profiles (for displaying names on
    //   tickets, quotes, comments, etc.). Sensitive fields could be split
    //   into a private subcollection if needed later.
    // - First-time users can create their OWN profile (role defaults to 'resident',
    //   staff promote it later via Settings)
    // - Self-updates can't change role or is_active
    // - Staff can update role / is_active on any profile
    match /profiles/{userId} {
      allow read: if isAuthed();

      // First sign-in self-creation. role MUST be 'resident' (or absent).
      allow create: if isAuthed()
        && isSelf(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'resident');

      // Self update of own profile — no role / is_active change
      allow update: if isAuthed() && isSelf(userId)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('is_active' in request.resource.data.diff(resource.data).affectedKeys());

      // Staff can promote / deactivate
      allow update: if isStaff();

      allow delete: if hasRole('admin');
    }

    // ---------- ROOMS ----------
    match /rooms/{roomId} {
      allow read: if isAuthed();
      allow write: if isStaff();
    }

    // ---------- TICKETS ----------
    // Read: any authenticated user (so contractors can see jobs to bid on)
    // Create: any authenticated user
    // Update: staff or the assigned contractor (latter for status transitions like awaiting_inspection)
    // Delete: admin only
    match /tickets/{ticketId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.created_by == request.auth.uid;

      allow update: if isStaff()
        || (hasRole('contractor') && resource.data.assigned_contractor == request.auth.uid);

      allow delete: if hasRole('admin');

      match /comments/{commentId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.author_id == request.auth.uid;
        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.uploaded_by == request.auth.uid;
        allow update: if false;
        allow delete: if isStaff()
          || (isAuthed() && resource.data.uploaded_by == request.auth.uid);
      }

      match /approvals/{approvalId} {
        allow read: if isAuthed();
        allow create: if isStaff()
          && request.resource.data.approver_id == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- QUOTATIONS ----------
    // Read: contractor sees own; staff see all
    // Create: any contractor (must set their uid as contractor_id)
    // Update: staff (status changes); contractor can update their own draft fields
    // Delete: admin
    match /quotations/{quoteId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );

      allow create: if hasRole('contractor')
        && request.resource.data.contractor_id == request.auth.uid;

      allow update: if isStaff();
      allow delete: if hasRole('admin');

      match /items/{itemId} {
        allow read: if isAuthed();
        allow create: if hasRole('contractor');
        allow update, delete: if isStaff();
      }
    }

    // ---------- PAYMENTS ----------
    // Read: contractor sees own; staff see all
    // Create / authorize / mark-paid: staff only
    match /payments/{paymentId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if hasRole('admin');
    }

    // ---------- CONTRACTOR RATINGS ----------
    match /contractor_ratings/{ratingId} {
      allow read: if isAuthed() && (
        isStaff()
        || (hasRole('contractor') && resource.data.contractor_id == request.auth.uid)
      );
      allow create, update: if isStaff()
        && request.resource.data.rated_by == request.auth.uid;
      allow delete: if hasRole('admin');
    }

    // ---------- NOTIFICATIONS ----------
    // Users read / mark-read their own. Anyone can create a notification for another
    // user (to support fan-out). The created notification must have read=false.
    match /notifications/{notifId} {
      allow read: if isAuthed() && resource.data.user_id == request.auth.uid;

      allow create: if isAuthed()
        && request.resource.data.read == false
        && 'user_id' in request.resource.data;

      allow update: if isAuthed() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);

      allow delete: if false;
    }

    // ---------- AUDIT LOGS ----------
    // Anyone authenticated can append (write own user_id only). Staff can read.
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthed()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
