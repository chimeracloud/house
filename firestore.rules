rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getProfile().role == role;
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && getProfile().role in roles;
    }

    function isStaff() {
      return hasAnyRole(['admin', 'property_owner', 'property_manager']);
    }

    // Profiles — users can read their own; staff can read all; only backend writes
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow write: if false; // backend only
    }

    // Tickets — all authenticated users can read; any authenticated user can create
    // Only staff can update
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff();
      allow delete: if hasRole('admin');

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isStaff();
      }

      match /approvals/{approvalId} {
        allow read: if isAuthenticated();
        allow write: if false; // backend only
      }
    }

    // Quotations — contractors see their own; staff see all
    match /quotations/{quoteId} {
      allow read: if isAuthenticated() && (
        hasRole('contractor') ? resource.data.contractor_id == request.auth.uid : isStaff()
      );
      allow create: if hasRole('contractor');
      allow update: if false; // backend only
      allow delete: if hasRole('admin');

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow write: if false; // backend only
      }
    }

    // Payments — contractors see their own; staff see all
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        hasRole('contractor') ? resource.data.contractor_id == request.auth.uid : isStaff()
      );
      allow write: if false; // backend only
    }

    // Contractor ratings — staff and contractors can read their own
    match /contractor_ratings/{ratingId} {
      allow read: if isAuthenticated() && (
        hasRole('contractor') ? resource.data.contractor_id == request.auth.uid : isStaff()
      );
      allow write: if false; // backend only
    }

    // Notifications — users see their own only
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);
      allow write: if false;
    }

    // Audit logs — staff read only, no client writes
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Rooms — all authenticated users can read; only staff can write
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
  }
}
